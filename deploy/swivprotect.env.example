# Copy to /etc/swivprotect.env on the server and edit. NEVER commit the real file (it may hold keys).
PORT=3000
# only answer through the web front end (Caddy), never directly from the internet
HOST=127.0.0.1
# the front end sets X-Forwarded-For, so people are told apart by their real address. Only safe together with HOST=127.0.0.1.
TRUST_PROXY=1

# Gmail add-on sign-in (leave out until you have the value; see docs/DEPLOY.md, "Gmail add-on")
#GOOGLE_AUDIENCE=

# optional plain-language explanation of scam checks
#ANTHROPIC_API_KEY=
